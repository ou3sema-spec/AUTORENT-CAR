rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic Validation Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role-based helper functions looking up the user profile document in /appUsers/$(request.auth.uid)
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/appUsers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.role
        : (request.auth.token.role != null ? request.auth.token.role : 'CUSTOMER');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'ou3sema@gmail.com' ||
        getUserRole() == 'ADMIN'
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() ||
        getUserRole() == 'MANAGER'
      );
    }

    function isAgent() {
      return isSignedIn() && (
        isManager() ||
        getUserRole() == 'AGENT'
      );
    }

    function isFleetStaff() {
      return isSignedIn() && (
        isManager() ||
        getUserRole() == 'FLEET'
      );
    }

    function isAccountant() {
      return isSignedIn() && (
        isManager() ||
        getUserRole() == 'ACCOUNTANT'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || isManager() || isAgent() || isFleetStaff() || isAccountant()
      );
    }

    // Customer Ownership validation
    function isCustomerOwner(clientId) {
      return isSignedIn() && (
        request.auth.uid == clientId ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email))
      );
    }

    // --- 0. Health & Connection Test ---
    match /test/{docId} {
      allow read: if true;
    }

    // --- 1. App Users (Staff Profiles & Accounts) ---
    match /appUsers/{userId} {
      // Staff can view staff directory; user can view their own profile
      allow read: if isSignedIn() && (isStaff() || request.auth.uid == userId);
      // Only Admin or Manager can create/update staff accounts; user can update non-privileged self fields
      allow create: if isValidId(userId) && (
        isAdmin() || (isSignedIn() && request.auth.uid == userId && incoming().role == 'CUSTOMER')
      );
      allow update: if isValidId(userId) && (
        isAdmin() || (isManager() && existing().role != 'ADMIN') ||
        (isSignedIn() && request.auth.uid == userId && incoming().role == existing().role)
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // --- 2. Vehicles Collection ---
    match /vehicles/{vehicleId} {
      // Fleet details are accessible for browsing available fleet
      allow read: if true;
      allow create, update: if isValidId(vehicleId) && (
        isAdmin() || isManager() || isFleetStaff() || isAgent()
      );
      allow delete: if isValidId(vehicleId) && (isAdmin() || isManager());
    }

    // --- 3. Clients Collection ---
    match /clients/{clientId} {
      // Staff have access; Customers can only read and update their own client record
      allow read: if isStaff() || isCustomerOwner(clientId);
      allow create: if isValidId(clientId) && (
        isStaff() || (isSignedIn() && request.auth.uid == clientId)
      );
      allow update: if isValidId(clientId) && (
        isStaff() || isCustomerOwner(clientId)
      );
      allow delete: if isValidId(clientId) && (isAdmin() || isManager());
    }

    // --- 4. Bookings Collection ---
    match /bookings/{bookingId} {
      // Staff can read all bookings; Customer can read their own bookings
      allow read: if isStaff() || (
        isSignedIn() && (
          resource.data.clientId == request.auth.uid ||
          resource.data.clientEmail == request.auth.token.email ||
          resource.data.userId == request.auth.uid
        )
      );
      // Create: staff or customer creating a reservation for themselves
      allow create: if isValidId(bookingId) && (
        isStaff() || (isSignedIn() && incoming().clientId == request.auth.uid)
      );
      // Update: staff can update; customer can sign agreement or pay
      allow update: if isValidId(bookingId) && (
        isStaff() || (
          isSignedIn() && (
            resource.data.clientId == request.auth.uid ||
            resource.data.clientEmail == request.auth.token.email
          )
        )
      );
      allow delete: if isValidId(bookingId) && (isAdmin() || isManager());
    }

    // --- 5. Payments Collection ---
    match /payments/{paymentId} {
      allow read: if isAccountant() || isStaff() || (
        isSignedIn() && resource.data.clientId == request.auth.uid
      );
      allow create: if isValidId(paymentId) && (
        isAccountant() || isStaff() || (isSignedIn() && incoming().clientId == request.auth.uid)
      );
      allow update: if isValidId(paymentId) && (isAccountant() || isStaff());
      allow delete: if isValidId(paymentId) && (isAdmin() || isManager());
    }

    // --- 6. Invoices Collection ---
    match /invoices/{invoiceId} {
      allow read: if isAccountant() || isStaff() || (
        isSignedIn() && resource.data.clientId == request.auth.uid
      );
      allow create, update: if isValidId(invoiceId) && (isAccountant() || isStaff());
      allow delete: if isValidId(invoiceId) && (isAdmin() || isManager());
    }

    // --- 7. Maintenances Collection ---
    match /maintenances/{maintenanceId} {
      allow read: if isStaff();
      allow create, update: if isValidId(maintenanceId) && (isAdmin() || isManager() || isFleetStaff());
      allow delete: if isValidId(maintenanceId) && (isAdmin() || isManager());
    }

    // --- 8. Check-Ins & Check-Outs (Inspections) ---
    match /checkIns/{checkInId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource.data.clientId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update: if isValidId(checkInId) && (
        isStaff() || (isSignedIn() && incoming().clientId == request.auth.uid)
      );
      allow delete: if isValidId(checkInId) && (isAdmin() || isManager());
    }

    match /checkOuts/{checkOutId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource.data.clientId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update: if isValidId(checkOutId) && (
        isStaff() || (isSignedIn() && incoming().clientId == request.auth.uid)
      );
      allow delete: if isValidId(checkOutId) && (isAdmin() || isManager());
    }

    // --- 9. Damage Records ---
    match /damageRecords/{damageId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.clientId == request.auth.uid
      );
      allow create, update: if isValidId(damageId) && isStaff();
      allow delete: if isValidId(damageId) && (isAdmin() || isManager());
    }

    // --- 10. Activity Logs (Audit Trail) ---
    match /activityLogs/{logId} {
      allow read: if isStaff();
      // Any authenticated user/action can create an audit log, but logs can NEVER be updated or deleted
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false; // Immutable audit log
    }

    // --- 11. Agencies Collection ---
    match /agencies/{agencyId} {
      allow read: if true; // Public agency locations and contacts
      allow create, update: if isValidId(agencyId) && (isAdmin() || isManager());
      allow delete: if isValidId(agencyId) && isAdmin();
    }

    // --- 12. Notifications ---
    match /notifications/{notifId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isStaff();
    }
  }
}
